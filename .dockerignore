# Những thứ KHÔNG được copy vào build context / image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Git & CI
.git
.gitignore
.github

# Python
__pycache__
*.py[cod]
.venv
venv
env
.pytest_cache
*.egg-info

# Không cần trong image runtime
tests
screenshots
nginx
*.md
Dockerfile*
docker-compose*.yml
.dockerignore

# OS / editor
.DS_Store
Thumbs.db
.idea
.vscode
*.log
